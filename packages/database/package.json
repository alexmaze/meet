{
  "name": "@meet/database",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:migrate:teaching-spike": "drizzle-kit migrate --config drizzle.teaching-spike.config.ts"
  },
  "dependencies": {
    "@meet/protocol": "workspace:*",
    "drizzle-orm": "0.45.1",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.21.0",
    "drizzle-kit": "0.31.10"
  }
}
