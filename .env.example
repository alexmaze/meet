# 本地服务
API_HOST=0.0.0.0
API_PORT=8787
WEB_PORT=5173
LOG_LEVEL=info

# PostgreSQL 与账号登录。请替换示例密码；生产环境必须使用 HTTPS。
DATABASE_URL=postgresql://meet:change-me@127.0.0.1:5432/meet
AUTH_SESSION_TTL_DAYS=30
# 本地 HTTP 开发设为 false；生产 HTTPS 部署必须设为 true。
AUTH_COOKIE_SECURE=false
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_LOGIN_WINDOW_SECONDS=300

# 私人媒体对象目录。生产环境应放在持久化磁盘，并与数据库一起纳入磁盘快照。
MEDIA_LOCAL_DIR=./data/media

# 内置 Embedding 模型缓存目录。首次测试时下载模型，API 与 Worker 共用此持久化目录。
EMBEDDING_LOCAL_CACHE_DIR=./data/embedding-models

# Embedding 连接、密钥、模型和向量维度由管理员在“我的 → 模型设置”维护。
# Mem0 OSS SDK 默认启用匿名遥测；Meet 私有部署示例在进程级关闭。
MEM0_TELEMETRY=false

# 实时语音与文本模型不再通过环境变量配置。
# 使用管理员账号登录后，在“我的 → 模型设置”中录入供应商连接、API 密钥、模型与音色。
