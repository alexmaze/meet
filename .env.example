# 本地服务
API_HOST=127.0.0.1
API_PORT=8787
WEB_PORT=5173
LOG_LEVEL=info

# PostgreSQL 与账号登录。请替换示例密码；生产环境必须使用 HTTPS。
DATABASE_URL=postgresql://meet:change-me@127.0.0.1:5432/meet
AUTH_SESSION_TTL_DAYS=30
# 本地 HTTP 开发设为 false；生产 HTTPS 部署必须设为 true。
AUTH_COOKIE_SECURE=false
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_LOGIN_WINDOW_SECONDS=300

# 第一版默认千问 WebSocket PCM 实现。复制本文件为 .env 后填写，不要提交真实值。
REALTIME_SPIKE_ENABLED=true
DASHSCOPE_API_KEY=
# WebRTC 白名单开通后由阿里云商务提供，填写纯 hostname 或 HTTPS Origin。
QWEN_REALTIME_ENDPOINT=
QWEN_REALTIME_REGION=cn-beijing
QWEN_REALTIME_MODEL=qwen-audio-3.0-realtime-plus
QWEN_REALTIME_VOICE=longanqian
QWEN_REALTIME_REQUEST_TIMEOUT_MS=15000
QWEN_REALTIME_INSTRUCTIONS=你是一位自然、耐心、有角色感的中文聊天伙伴。先听清用户再回答，默认简短口语化，不要像客服或说明书。

# 会话摘要与长期记忆分析。北京地域使用下列兼容接口；其他地域按百炼控制台配置。
QWEN_ANALYSIS_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_ANALYSIS_MODEL=qwen-plus
QWEN_ANALYSIS_REQUEST_TIMEOUT_MS=60000
