# 本地服务
API_HOST=0.0.0.0
API_PORT=8787
WEB_PORT=5173
LOG_LEVEL=info

# PostgreSQL 与账号登录。请替换示例密码；生产环境必须使用 HTTPS。
# API 启动时会自动应用迁移；也可单独执行 pnpm db:migrate。
DATABASE_URL=postgresql://meet:change-me@127.0.0.1:5432/meet
# 仅供人工授权的实时教学 Spike 默认隔离模式使用。必须指向独立、可丢弃的测试数据库，
# 不得与 DATABASE_URL 指向同一个数据库；普通 API、Worker 和 dry-run/Mock 不读取它。
# 如需逐次显式改用现有应用数据库，请在 live CLI 添加 --use-application-database；
# 该模式直接读取 DATABASE_URL，不需要也不会使用下面的独立库 URL。
TEACHING_SPIKE_DATABASE_URL=postgresql://meet_spike:change-me@127.0.0.1:5432/meet_teaching_spike

# 儿童学习小支线默认关闭。只有完成受控 Provider 验证后，才应绑定本次
# 验证使用的精确模型配置与连接修订并显式开启。
TEACHING_QWEN_DYNAMIC_ENABLED=false
TEACHING_QWEN_MODEL_PROFILE_ID=
TEACHING_QWEN_MODEL_PROFILE_REVISION=
TEACHING_QWEN_CONNECTION_ID=
TEACHING_QWEN_CONNECTION_REVISION=
# 可选：为其他已逐项审阅的千问模型配置增加完整精确绑定。值必须是严格 JSON 数组；
# 每项都必须包含 modelProfileId、modelProfileRevision、connectionId、connectionRevision。
TEACHING_QWEN_DYNAMIC_ADDITIONAL_BINDINGS=[]
AUTH_SESSION_TTL_DAYS=30
# 本地 HTTP 开发设为 false；生产 HTTPS 部署必须设为 true。
AUTH_COOKIE_SECURE=false
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_LOGIN_WINDOW_SECONDS=300

# 可选：空库首次启动 API 时创建首位管理员。
# 须同时设置用户名与密码；显示名可选，默认与用户名相同。
# 已有任意账号时跳过，不会按环境变量改密或改用户名。
# 也可改用交互式：pnpm admin:init --username admin --display-name 家庭管理员
# INITIAL_ADMIN_USERNAME=admin
# INITIAL_ADMIN_PASSWORD=change-me
# INITIAL_ADMIN_DISPLAY_NAME=家庭管理员

# 私人媒体对象目录。生产环境应放在持久化磁盘，并与数据库一起纳入磁盘快照。
MEDIA_LOCAL_DIR=./data/media

# 内置 Embedding 模型缓存目录。首次测试时下载模型，API 与 Worker 共用此持久化目录。
EMBEDDING_LOCAL_CACHE_DIR=./data/embedding-models

# Embedding 连接、密钥、模型和向量维度由管理员在“我的 → 模型设置”维护。
# Mem0 OSS SDK 默认启用匿名遥测；Meet 私有部署示例在进程级关闭。
MEM0_TELEMETRY=false

# 实时语音与文本模型不再通过环境变量配置。
# 使用管理员账号登录后，在“我的 → 模型设置”中录入供应商连接、API 密钥、模型与音色。
