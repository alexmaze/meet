# Docker Compose 部署用环境变量。
# 复制为 .env.compose 后填写；勿覆盖本地开发用的 .env。
#
#   cp .env.compose.example .env.compose
#   docker compose --env-file .env.compose up -d

# 已发布的镜像版本（对应 git tag v0.1.1 时填 0.1.1；也可用 latest）
MEET_VERSION=latest

# PostgreSQL 密码（勿使用会破坏 URL 的特殊字符，如 @ # : / ?）
POSTGRES_PASSWORD=change-me

# 对外映射 web 端口（容器内 80）
WEB_PUBLISH_PORT=8080

# 仅本机 HTTP 试用可保持 false；域名 + HTTPS 反代后必须改为 true
AUTH_COOKIE_SECURE=false

LOG_LEVEL=info
AUTH_SESSION_TTL_DAYS=30
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_LOGIN_WINDOW_SECONDS=300

# 可选：空库首次启动时由 API 创建首位管理员。
# 用户名与密码须同时设置；显示名可选，默认与用户名相同。
# 仅在没有任何账号时生效；已有账号时跳过，不会按环境变量改密。
# 首次成功登录并改密后，建议从环境文件中删除 INITIAL_ADMIN_PASSWORD。
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me
INITIAL_ADMIN_DISPLAY_NAME=家庭管理员

MEM0_TELEMETRY=false
